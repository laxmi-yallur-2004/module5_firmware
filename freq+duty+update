#include <LiquidCrystal.h>

// LCD: RS, EN, D4, D5, D6, D7
LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

// PWM output pin
const int PWM_PIN = 3;

// Duty cycle
int duty = 50;

// Timer for duty-cycle update
unsigned long lastUpdate = 0;
const unsigned long UPDATE_INTERVAL = 1000;

void setup()
{
  lcd.begin(16, 2);

  pinMode(PWM_PIN, OUTPUT);

  // Timer2 Fast PWM, non-inverting mode on OC2B (D3)
  TCCR2A = 0;
  TCCR2B = 0;

  TCCR2A |= (1 << WGM20) | (1 << WGM21);
  TCCR2A |= (1 << COM2B1);

  // Prescaler = 64
  TCCR2B |= (1 << CS22);

  // Initial duty cycle = 50%
  OCR2B = 128;

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("PWM: 977 Hz");

  lcd.setCursor(0, 1);
  lcd.print("DUTY: 50%");
}

void loop()
{
  unsigned long currentTime = millis();

  if (currentTime - lastUpdate >= UPDATE_INTERVAL)
  {
    lastUpdate = currentTime;

    duty += 25;

    if (duty > 100)
    {
      duty = 0;
    }

    OCR2B = map(duty, 0, 100, 0, 255);

    lcd.setCursor(0, 1);
    lcd.print("DUTY:     ");
    lcd.setCursor(6, 1);
    lcd.print(duty);
    lcd.print("%");
  }
}
