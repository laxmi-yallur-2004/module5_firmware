#include <LiquidCrystal.h>

// LCD: RS, EN, D4, D5, D6, D7
LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

// Test signal output
const int SIGNAL_PIN = 3;

// Interrupt input
const int CAPTURE_PIN = 2;

volatile unsigned long lastCapture = 0;
volatile unsigned long periodTicks = 0;
volatile bool newCapture = false;

unsigned long lastDisplay = 0;
const unsigned long DISPLAY_INTERVAL = 500;

void captureEdge()
{
  unsigned long currentCapture = TCNT1;

  periodTicks = currentCapture - lastCapture;
  lastCapture = currentCapture;

  newCapture = true;
}

void setup()
{
  lcd.begin(16, 2);

  pinMode(SIGNAL_PIN, OUTPUT);
  pinMode(CAPTURE_PIN, INPUT);

  // Timer2 generates approximately 500 Hz on D3
  TCCR2A = 0;
  TCCR2B = 0;

  TCCR2A |= (1 << WGM20) | (1 << WGM21);
  TCCR2A |= (1 << COM2B1);

  // Prescaler = 64
  TCCR2B |= (1 << CS22);

  // Approximately 50% duty cycle
  OCR2B = 128;

  // Timer1 normal mode
  TCCR1A = 0;
  TCCR1B = 0;

  // Timer1 prescaler = 8
  TCCR1B |= (1 << CS11);

  TCNT1 = 0;

  attachInterrupt(
    digitalPinToInterrupt(CAPTURE_PIN),
    captureEdge,
    RISING
  );

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("CAPTURE:");
  lcd.setCursor(0, 1);
  lcd.print("FREQ:Waiting");
}

void loop()
{
  unsigned long currentTime = millis();

  if (currentTime - lastDisplay >= DISPLAY_INTERVAL)
  {
    lastDisplay = currentTime;

    if (newCapture)
    {
      noInterrupts();

      unsigned long ticks = periodTicks;
      newCapture = false;

      interrupts();

      if (ticks > 0)
      {
        // Timer1 clock = 16 MHz / 8 = 2 MHz
        // Therefore each tick = 0.5 us
        unsigned long frequency = 2000000UL / ticks;

        lcd.setCursor(0, 0);
        lcd.print("CAPTURE:        ");

        lcd.setCursor(0, 1);
        lcd.print("FREQ:");
        lcd.print(frequency);
        lcd.print(" Hz   ");
      }
    }
  }
}
